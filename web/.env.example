# URL of the Go backend WebSocket server.
# The room page connects here directly; it does not proxy through Next.js.
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# URL of the Go backend REST API — auth, rooms, and the Run proxy.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Production (Vercel)
#
# Set these two in the Vercel project settings, pointing at the Render
# service. Note the schemes: https for the API, wss for the socket. A Vercel
# page is served over https, so a plain ws:// socket is blocked as mixed
# content and the room will never connect.
#
#   NEXT_PUBLIC_API_URL=https://syncr-api.onrender.com
#   NEXT_PUBLIC_WS_URL=wss://syncr-api.onrender.com
#
# NEXT_PUBLIC_* values are inlined at build time, not read at runtime, so
# editing them in Vercel requires a redeploy before anything changes.
# ---------------------------------------------------------------------------
